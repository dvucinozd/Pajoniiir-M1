  (text "FS routing target remains 90 ohm differential. R_USB1_DM/DP = 22R initial near P4; 27R/33R are tuning alternatives." (exclude_from_sim no) (at 35 95 0) (effects (font (size 1.27 1.27))) (uuid "08000046-8000-4800-8800-000000000047"))
  (text "C_USB1_DM/DP are DNP-only EMI tuning footprints. Populate symmetrically and revalidate USB SI if ever used." (exclude_from_sim no) (at 35 100 0) (effects (font (size 1.27 1.27))) (uuid "08000047-8000-4800-8800-000000000048"))
  (text "TPD2EUSB30A must sit at J_USB1. USB1_VBUS comes exclusively from U_USB1 TPS25221." (exclude_from_sim no) (at 35 105 0) (effects (font (size 1.27 1.27))) (uuid "08000048-8000-4800-8800-000000000049"))
  (text "P4 GPIO24/25 are NOT consumed here; preserve them for USB Serial/JTAG factory/service access in sheet 13." (exclude_from_sim no) (at 35 110 0) (effects (font (size 1.27 1.27))) (uuid "08000049-8000-4800-8800-00000000004a"))
