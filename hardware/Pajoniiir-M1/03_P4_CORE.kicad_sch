  (text "CRITICAL: physical package pin 54 = VDD_HP_1 on v3.x. All VDD_HP_0/1/2/3 are tied to P4_VDD_HP." (exclude_from_sim no) (at 20 175 0) (effects (font (size 1.27 1.27))) (uuid "c30001d0-3333-4333-8333-0000000001d1"))
  (text "Core feedback: 499k P4_VDD_HP->FB, 499k FB->GND, 22pF in parallel with upper 499k per Espressif v3.x TLV62569 reference." (exclude_from_sim no) (at 20 180 0) (effects (font (size 1.27 1.27))) (uuid "c30001d1-3333-4333-8333-0000000001d2"))
  (text "VDDO_3 is firmware-configured to 2.5V for MIPI DPHY. VDDO_4 is intentionally unused/NC in Rev A (no SDIO 3.0 voltage switching)." (exclude_from_sim no) (at 20 185 0) (effects (font (size 1.27 1.27))) (uuid "c30001d2-3333-4333-8333-0000000001d3"))
