  (text "USB0: RILIM 54.9k (~1.0A nominal initial). USB1: RILIM 34.8k (~1.6A nominal initial). Final values require EVT characterization." (exclude_from_sim no) (at 35 125 0) (effects (font (size 1.27 1.27))) (uuid "f6000089-6666-4666-8666-00000000008a"))
  (text "Both ports default OFF with 100k EN pulldowns. FAULT is active-low open-drain with 10k pull-up to 3V3_SYS." (exclude_from_sim no) (at 35 130 0) (effects (font (size 1.27 1.27))) (uuid "f600008a-6666-4666-8666-00000000008b"))
  (text "Per-port output: 100nF + 47uF initial + 100uF DNP tuning. Route with USB_VBUS_HIGH_CURRENT class." (exclude_from_sim no) (at 35 135 0) (effects (font (size 1.27 1.27))) (uuid "f600008b-6666-4666-8666-00000000008c"))
