  (text "J6 = Amphenol SFW15R-2STE1LF, 15P 1.0mm TOP contact. Pin map follows M3 accepted J2: GND/D1/CLK/D0/I2C/3V3." (exclude_from_sim no) (at 144.78 139.7 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "ce461665-b487-5837-8e53-43feef74e815"))
