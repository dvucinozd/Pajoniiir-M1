  (text "GT911 is expected on the display/touch assembly; no bare GT911 IC is populated on the M1 mainboard baseline." (exclude_from_sim no) (at 35 118 0) (effects (font (size 1.27 1.27))) (uuid "0b000058-b000-4b00-8b00-000000000059"))
  (text "Address target 0x5D: drive INT LOW while RST is asserted, release RST, wait, then return INT to high-impedance input with no internal pulls." (exclude_from_sim no) (at 35 123 0) (effects (font (size 1.27 1.27))) (uuid "0b000059-b000-4b00-8b00-00000000005a"))
  (text "I2C baseline 100kHz for bring-up; 4.7k pull-ups to 3V3_TOUCH. Parallel 4.7k footprints are DNP tuning options for 400kHz/FPC capacitance." (exclude_from_sim no) (at 35 128 0) (effects (font (size 1.27 1.27))) (uuid "0b00005a-b000-4b00-8b00-00000000005b"))
  (text "PANEL_TOUCH_RST/INT and TOUCH_SDA/SCL are logical panel-side nets only. Exact physical pins remain blocked by the shared J_LCD FPC hard gate." (exclude_from_sim no) (at 35 133 0) (effects (font (size 1.27 1.27))) (uuid "0b00005b-b000-4b00-8b00-00000000005c"))
  (text "Firmware M1 mapping: GPIO3 TOUCH_RST, GPIO4 TOUCH_INT, GPIO7 SDA, GPIO8 SCL." (exclude_from_sim no) (at 35 138 0) (effects (font (size 1.27 1.27))) (uuid "0b00005c-b000-4b00-8b00-00000000005d"))
